<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BizNexa Solutions | Data Management, Zoho Customisation, Finance and Integration & Web Solutions</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy: #0F172A;
            --blue: #2563EB;
            --cyan: #06B6D4;
            --light-bg: #F8FAFC;
            --text-dark: #1E293B;
            --text-muted: #64748B;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--light-bg);
            color: var(--text-dark);
            line-height: 1.6;
        }

        /* Header / Navbar */
        header {
            background: #ffffff;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.8rem 2rem;
        }

        .logo-img {
            height: 100px;
            width: auto;
            display: block;
        }

        nav a {
            text-decoration: none;
            color: var(--text-dark);
            margin-left: 1.5rem;
            font-weight: 500;
            transition: 0.3s;
        }

        nav a:hover {
            color: var(--blue);
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, var(--navy) 0%, #1E293B 100%);
            color: #ffffff;
            padding: 5rem 2rem;
            text-align: center;
        }

        .hero-content {
            max-width: 800px;
            margin: 0 auto;
        }

        .hero h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .hero h1 span {
            color: var(--cyan);
        }

        .hero p {
            font-size: 1.1rem;
            color: #94A3B8;
            margin-bottom: 2rem;
        }

        .btn {
            display: inline-block;
            background: linear-gradient(90deg, var(--blue), var(--cyan));
            color: white;
            padding: 0.8rem 2rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
            transition: transform 0.2s;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        /* Services Section */
        .services {
            max-width: 1200px;
            margin: 4rem auto;
            padding: 0 2rem;
        }

        .section-title {
            text-align: center;
            margin-bottom: 3rem;
        }

        .section-title h2 {
            font-size: 2rem;
            color: var(--navy);
        }

        .section-title p {
            color: var(--text-muted);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .card {
            background: white;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            border-top: 4px solid var(--blue);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .card h3 {
            font-size: 1.25rem;
            margin-bottom: 1rem;
            color: var(--navy);
        }

        .card ul {
            list-style: none;
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .card ul li {
            margin-bottom: 0.5rem;
            position: relative;
            padding-left: 1.2rem;
        }

        .card ul li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--cyan);
            font-weight: bold;
        }

        /* Why Choose Us */
        .why-us {
            background: #ffffff;
            padding: 4rem 2rem;
            border-top: 1px solid #E2E8F0;
        }

        .why-container {
            max-width: 1000px;
            margin: 0 auto;
            text-align: center;
        }

        .stats-grid {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            margin-top: 2rem;
            gap: 1.5rem;
        }

        .stat-item h3 {
            font-size: 2.5rem;
            color: var(--blue);
        }

        /* Contact Section */
        .contact {
            max-width: 600px;
            margin: 4rem auto;
            padding: 2rem;
            background: white;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        .contact form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .contact input, .contact select, .contact textarea {
            padding: 0.8rem;
            border: 1px solid #CBD5E1;
            border-radius: 5px;
            outline: none;
            font-size: 0.95rem;
        }

        .contact input:focus, .contact select:focus, .contact textarea:focus {
            border-color: var(--blue);
        }

        /* Footer */
        footer {
            background: var(--navy);
            color: #94A3B8;
            text-align: center;
            padding: 1.5rem;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="nav-container">
            <div>
                <!-- Google Drive Direct Image Link -->
                <img src="https://lh3.googleusercontent.com/d/1UkX9RutX1OElqvdKZSqt4hQ6zT4N8xK-" alt="BizNexa Solutions Logo" class="logo-img">
            </div>
            <nav>
                <a href="#services">Services</a>
                <a href="#why-us">About Us</a>
                <a href="#contact">Contact</a>
            </nav>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1>Transforming Complex Data into <span>Actionable Growth</span></h1>
            <p>We help businesses automate workflows, build dynamic analytics dashboards, and deploy custom web solutions—saving up to 60% of manual effort.</p>
            <a href="#contact" class="btn">Get a Free Audit</a>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services" id="services">
        <div class="section-title">
            <h2>Our Core Expertise</h2>
            <p>End-to-end data, automation, and web solutions tailored for business growth.</p>
        </div>
        <div class="grid">
            <!-- Card 1 -->
            <div class="card">
                <h3>📊 Data Management & Dashboards</h3>
                <ul>
                    <li>Power BI & Google Looker Studio</li>
                    <li>Real-time Metrics Tracking</li>
                    <li>SQL, Excel & CRM Integration</li>
                    <li>Automated Reporting Tools</li>
                </ul>
            </div>
            <!-- Card 2 -->
            <div class="card">
                <h3>⚙️ Process Automation</h3>
                <ul>
                    <li>Google Sheets & Workflow Automation</li>
                    <li>WHMCS, Brevo & Zoho CRM Setup</li>
                    <li>WhatsApp & Email Service Triggers</li>
                    <li>Reduce Manual Entry by up to 70%</li>
                </ul>
            </div>
            <!-- Card 3 -->
            <div class="card">
                <h3>💰 Financial & Integration</h3>
                <ul>
                    <li>Advanced Excel & Power Query</li>
                    <li>GST & Tax Compliance Models</li>
                    <li>Accounts Reconciliation Systems</li>
                    <li>C-Suite Financial Dashboards</li>
                </ul>
            </div>
            <!-- Card 4 -->
            <div class="card">
                <h3>🤖 AI Web & Tool Building</h3>
                <ul>
                    <li>Fast-Loading Corporate Websites</li>
                    <li>Custom Web Forms & Calculators</li>
                    <li>API & Cloud App Integration</li>
                    <li>AI-Powered Landing Pages</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="why-us" id="why-us">
        <div class="why-container">
            <h2>The BizNexa Advantage</h2>
            <p>Combining decade-long financial analytics expertise with cutting-edge business automation.</p>
            <div class="stats-grid">
                <div class="stat-item">
                    <h3>10+</h3>
                    <p>Years Experience</p>
                </div>
                <div class="stat-item">
                    <h3>60%</h3>
                    <p>Workload Reduced</p>
                </div>
                <div class="stat-item">
                    <h3>100%</h3>
                    <p>Data Accuracy Focus</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <div class="section-title">
            <h2>Let's Talk Business</h2>
            <p>Ready to streamline your operations?</p>
        </div>
        <form onsubmit="alert('Thank you! We will reach out shortly.'); return false;">
            <input type="text" placeholder="Your Name" required>
            <input type="email" placeholder="Your Email Address" required>
            <select required>
                <option value="" disabled selected>Select Required Service</option>
                <option value="analytics">Data Analytics & Dashboards</option>
                <option value="automation">Process Automation</option>
                <option value="financial">Financial & ERP Reporting</option>
                <option value="web">AI Web / Tool Building</option>
            </select>
            <textarea rows="4" placeholder="Briefly describe your business needs..." required></textarea>
            <button type="submit" class="btn">Send Message</button>
        </form>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 BizNexa Solutions. All Rights Reserved. | Designed for Innovation</p>
    </footer>

</body>
</html>
